{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "strict": true,
    "strictNullChecks": true
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.js"],
  "exclude": [
    ".ayoitson",
    ".dizquetv",
    ".dizquetv-*",
    ".dizquetv.backup-*",
    "bin",
    "dist",
    "node_modules",
    "tests",
    "web"
  ]
}
